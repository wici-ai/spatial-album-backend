# syntax=docker/dockerfile:1.7
#
# CUDA 12.8 backend image for the form-1 local install.
# The repo itself is mounted by docker-compose so endpoint code stays outside
# the image. Third-party model code is copied from git submodules.

ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_PROGRESS_BAR=off

ARG TORCH_VERSION=2.11.0+cu128
ARG TORCHVISION_VERSION=0.26.0+cu128
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG GSPLAT_COMMIT=32f2a54d21c7ecb135320bb02b136b7407ae5712
ARG ORBIT_DIFFUSERS_COMMIT=447e8322f76efea55d4769cd67c372edbf0715b8
ARG SPZ_COMMIT=a4fc69e7948c7152e807e6501d73ddc9c149ce37
ARG FLUX_DIFFUSERS_TARBALL=https://github.com/huggingface/diffusers/archive/216e245c742c.tar.gz

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      colmap \
      curl \
      ffmpeg \
      git \
      git-lfs \
      libglib2.0-0 \
      libgl1 \
      libgomp1 \
      ninja-build \
      patch \
      python3-pip \
      python3.12 \
      python3.12-dev \
      python3.12-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && git lfs install --skip-repo

RUN mkdir -p /opt/venvs /opt/sota /opt/wici/deploy/scripts /models /runtime /home/wici

RUN python3 -m pip install --break-system-packages \
      "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" \
      --index-url "${TORCH_INDEX_URL}"

COPY third_party/ml-sharp /opt/sota/ml-sharp
COPY third_party/Difix3D /opt/Difix3D
RUN git clone https://github.com/nerfstudio-project/gsplat.git /opt/sota/gsplat \
    && git -C /opt/sota/gsplat checkout "${GSPLAT_COMMIT}" \
    && git -C /opt/sota/gsplat submodule update --init --recursive
COPY deploy/patches/gsplat-preload-training.patch /tmp/gsplat-preload-training.patch
RUN patch -p1 -d /opt/sota/gsplat < /tmp/gsplat-preload-training.patch

# Orbit venv: renders with gsplat and loads SHARP in-process.
# The old sharp-libs directory was a copied site-packages tree; keep the needed
# runtime packages as pins here instead of vendoring that 359 MiB binary tree.
RUN python3 -m venv --system-site-packages /opt/venvs/orbit \
    && /opt/venvs/orbit/bin/python -m pip install --upgrade pip "setuptools<82" wheel \
    && /opt/venvs/orbit/bin/python -m pip install \
      accelerate==1.14.0 \
      av==17.1.0 \
      click==8.3.0 \
      contourpy==1.3.3 \
      cycler==0.12.1 \
      einops==0.8.2 \
      fonttools==4.61.0 \
      ftfy==6.3.1 \
      huggingface-hub \
      imageio==2.37.0 \
      imageio-ffmpeg==0.6.0 \
      jaxtyping==0.3.3 \
      kiwisolver==1.4.9 \
      matplotlib==3.10.6 \
      moviepy==1.0.3 \
      nanobind==2.13.0 \
      numpy==2.4.4 \
      omegaconf==2.3.1 \
      opencv-python-headless==4.13.0.92 \
      packaging==25.0 \
      pandas==3.0.3 \
      pillow==12.2.0 \
      pillow-heif==1.1.1 \
      plyfile==1.1.2 \
      pyparsing==3.2.5 \
      python-dateutil==2.9.0.post0 \
      rich \
      safetensors==0.8.0 \
      scipy==1.16.2 \
      six==1.17.0 \
      timm==1.0.20 \
      transformers==5.12.1 \
      uvicorn==0.49.0 \
      wadler-lindig==0.1.7 \
    && TORCH_CUDA_ARCH_LIST=12.0 /opt/venvs/orbit/bin/python -m pip install --no-build-isolation \
      /opt/sota/gsplat \
    && /opt/venvs/orbit/bin/python -m pip install \
      "git+https://github.com/huggingface/diffusers.git@${ORBIT_DIFFUSERS_COMMIT}" \
      "git+https://github.com/nianticlabs/spz.git@${SPZ_COMMIT}" \
    && /opt/venvs/orbit/bin/python -m pip install --no-deps -e /opt/sota/ml-sharp

# Difix venv: mirrors the resident nvidia/difix_ref endpoint. xformers is
# intentionally not installed in this draft; the live endpoint runs on PyTorch
# SDPA with the cu128 stack.
RUN python3 -m venv --system-site-packages /opt/venvs/difix \
    && /opt/venvs/difix/bin/python -m pip install --upgrade pip "setuptools<82" wheel \
    && /opt/venvs/difix/bin/python -m pip install \
      accelerate==1.14.0 \
      diffusers==0.25.1 \
      einops==0.8.2 \
      "imageio[ffmpeg]" \
      huggingface-hub==0.25.1 \
      lpips \
      numpy==2.5.0 \
      opencv-python-headless==4.13.0.92 \
      peft==0.9.0 \
      pillow==12.2.0 \
      safetensors==0.8.0 \
      tokenizers==0.15.2 \
      torchmetrics \
      transformers==4.38.0 \
      wandb

# Flux venv: bnb8 + bf16 IO path from the live flux service.
RUN python3 -m venv --system-site-packages /opt/venvs/flux \
    && /opt/venvs/flux/bin/python -m pip install --upgrade pip "setuptools<82" wheel \
    && /opt/venvs/flux/bin/python -m pip install --pre \
      accelerate==1.13.0 \
      bitsandbytes==0.49.2 \
      huggingface-hub \
      numpy==2.4.4 \
      opencv-python-headless==4.13.0.92 \
      pillow==12.2.0 \
      protobuf \
      safetensors==0.8.0rc0 \
      sentencepiece \
      torchao==0.17.0 \
      transformers==5.9.0 \
      uvicorn==0.47.0 \
    && /opt/venvs/flux/bin/python -m pip install "${FLUX_DIFFUSERS_TARBALL}"

COPY deploy/scripts/start-service.sh /usr/local/bin/wici-start-service
COPY deploy/scripts/download_weights.py /usr/local/bin/wici-download-weights
RUN chmod +x /usr/local/bin/wici-start-service /usr/local/bin/wici-download-weights

WORKDIR /opt/wici/spatial-album-backend/backend
ENTRYPOINT ["/usr/local/bin/wici-start-service"]
