+    def _upload_tensor_chunked(self, source: Tensor) -> Tensor:
+        source = source.detach().contiguous().cpu()
+        target = torch.empty_like(source, device=self.device)
+        source_flat = source.view(-1)
+        target_flat = target.view(-1)
+        elems_per_chunk = max(1, self.cfg.preload_chunk_bytes // source.element_size())
+        for start in range(0, source_flat.numel(), elems_per_chunk):
+            end = min(start + elems_per_chunk, source_flat.numel())
+            target_flat[start:end].copy_(source_flat[start:end])
+        return target
+
+    def _preload_training_data(self) -> None:
+        if self.cfg.depth_loss:
+            raise ValueError("preload_train_data does not support depth_loss")
+        if self.cfg.patch_size is None:
+            raise ValueError("preload_train_data requires --patch-size")
+        started = time.time()
+        full_trainset = Dataset(self.parser, split="train", patch_size=None, load_depths=False)
+        images, Ks, camtoworlds, image_ids, masks = [], [], [], [], []
+        uploaded_bytes = 0
+        for item in range(len(full_trainset)):
+            sample = full_trainset[item]
+            image = sample["image"].contiguous().div(255.0)
+            images.append(self._upload_tensor_chunked(image))
+            uploaded_bytes += image.numel() * image.element_size()
+            Ks.append(sample["K"])
+            camtoworlds.append(sample["camtoworld"])
+            image_ids.append(int(sample["image_id"]))
+            masks.append(sample.get("mask"))
+        self.preloaded_train_images = images
+        self.preloaded_train_Ks = self._upload_tensor_chunked(torch.stack(Ks))
+        self.preloaded_train_camtoworlds = self._upload_tensor_chunked(torch.stack(camtoworlds))
+        self.preloaded_train_image_ids = self._upload_tensor_chunked(torch.tensor(image_ids, dtype=torch.long))
+        if all(mask is not None for mask in masks):
+            self.preloaded_train_masks = [self._upload_tensor_chunked(mask) for mask in masks]
+        probe = self.preloaded_train_images[-1][0, 0, 0].cpu().item()
+        expected = float(full_trainset[len(full_trainset) - 1]["image"][0, 0, 0]) / 255.0
+        if not math.isclose(probe, expected, rel_tol=0.0, abs_tol=1e-6):
+            raise RuntimeError(f"preload verification failed: remote={probe} expected={expected}")
+        print(json.dumps({
+            "event": "preload_ready",
+            "images": len(images),
+            "bytes": uploaded_bytes,
+            "chunkBytes": self.cfg.preload_chunk_bytes,
+            "elapsedSeconds": time.time() - started,
+        }), flush=True)
+
+    def _preloaded_training_batch(self, batch_items: Tensor):
+        assert self.preloaded_train_images is not None
+        assert self.preloaded_train_Ks is not None
+        assert self.preloaded_train_camtoworlds is not None
+        assert self.preloaded_train_image_ids is not None
+        items = [int(item) for item in batch_items.tolist()]
+        patch_size = self.cfg.patch_size
+        assert patch_size is not None
+        crops = []
+        K_deltas = torch.zeros((len(items), 3, 3), dtype=torch.float32)
+        mask_crops = []
+        for batch_idx, item in enumerate(items):
+            image = self.preloaded_train_images[item]
+            height, width = image.shape[:2]
+            x = np.random.randint(0, max(width - patch_size, 1))
+            y = np.random.randint(0, max(height - patch_size, 1))
+            crops.append(image[y : y + patch_size, x : x + patch_size])
+            K_deltas[batch_idx, 0, 2] = -float(x)
+            K_deltas[batch_idx, 1, 2] = -float(y)
+            if self.preloaded_train_masks is not None:
+                mask = self.preloaded_train_masks[item]
+                mask_crops.append(mask[y : y + patch_size, x : x + patch_size])
+        pixels = torch.stack(crops, dim=0)
+        Ks = torch.stack([self.preloaded_train_Ks[item] for item in items], dim=0)
+        Ks = Ks + self._upload_tensor_chunked(K_deltas)
+        camtoworlds = torch.stack([self.preloaded_train_camtoworlds[item] for item in items], dim=0)
+        image_ids = torch.stack([self.preloaded_train_image_ids[item] for item in items], dim=0)
+        masks = torch.stack(mask_crops, dim=0) if mask_crops else None
+        return camtoworlds, Ks, pixels, image_ids, masks
+
